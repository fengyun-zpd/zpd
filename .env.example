# ============================================================
# StockMind V1 环境变量样例（复制为 .env 使用）
# 本机 Docker Compose 运行时，db/redis 地址使用 compose 内主机名；
# WSL/裸机开发运行时，把主机名改为 127.0.0.1。
# ============================================================

# --- 数据库（PostgreSQL + pgvector）---
POSTGRES_DSN=postgresql+psycopg://stockmind:stockmind@db:5432/stockmind

# --- 缓存与任务协调（Redis）---
REDIS_URL=redis://redis:6379/0

# --- 模拟供应商 API ---
MOCK_SUPPLIER_URL=http://mock-supplier:8100
# 模拟供应商状态持久化文件（仅在非 Docker 运行时使用）
MOCK_SUPPLIER_STORE_PATH=
# 超时故障模式的延迟秒数（需大于 ORDER_TIMEOUT_SECONDS 才能演示 order_unknown）
MOCK_SUPPLIER_TIMEOUT_SLEEP=8

# --- 领域参数 ---
# 供应商调用超时（秒）：超时/歧义 -> order_unknown
ORDER_TIMEOUT_SECONDS=30
# LangGraph checkpoint 后端：postgres（默认/生产）或 memory（开发/测试）
CHECKPOINTER_BACKEND=postgres

# --- LLM（OpenAI 兼容接口；V1 验证 DeepSeek）---
# 留空时 Agent 进入 OFFLINE 演示模式：不调用真实 LLM，
# 由可回放的确定性编排路径完成参数提取与工具调用（用于无 Key 验证）。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- 本地中文 Embedding（RAG）---
# 首次运行会联网下载模型；无法下载时 RAG 检索退化为关键词路径并记录告警。
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_ENABLED=true

# --- 观测（Langfuse Cloud，可选）---
# 未配置时观测安全 no-op；配置后记录对话/LLM/工具/RAG/领域计算与错误并脱敏。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 评测成本单价（可选；run_eval.sh llm 模式用于估算单次运行成本，单位 USD/1K tokens）---
# 未配置时评测只报告 Token，不估算成本。
# LLM_PRICE_PER_1K_INPUT=
# LLM_PRICE_PER_1K_OUTPUT=
