# ============================================================
# StockMind V1 环境变量样例（复制为 .env 使用）
# 本机 Docker Compose 运行时，db/redis 地址使用 compose 内主机名；
# WSL/裸机开发运行时，把主机名改为 127.0.0.1。
# ============================================================

# --- 数据库（PostgreSQL + pgvector）---
POSTGRES_DSN=postgresql+psycopg://stockmind:stockmind@db:5432/stockmind

# --- 缓存与任务协调（Redis）---
REDIS_URL=redis://redis:6379/0

# --- 模拟供应商 API ---
MOCK_SUPPLIER_URL=http://mock-supplier:8100
# 模拟供应商状态持久化文件（仅在非 Docker 运行时使用）
MOCK_SUPPLIER_STORE_PATH=
# 超时故障模式的延迟秒数（需大于 ORDER_TIMEOUT_SECONDS 才能演示 order_unknown）
MOCK_SUPPLIER_TIMEOUT_SLEEP=8

# --- 领域参数 ---
# 供应商调用超时（秒）：超时/歧义 -> order_unknown
ORDER_TIMEOUT_SECONDS=30
# LangGraph checkpoint 后端：postgres（默认/生产）或 memory（开发/测试）
CHECKPOINTER_BACKEND=postgres

# --- LLM（OpenAI 兼容接口；V1 验证 DeepSeek）---
# LLM_MODE=auto（默认）：配置完整时优先真实 LLM，失败后降级 OFFLINE 并记录原因；
# LLM_MODE=offline：强制不调用外部模型（评测确定性基线）；
# LLM_MODE=llm：评测真实模型路径，配置不完整时记录 LLM_NOT_CONFIGURED 并降级，
#               不发起请求，也不假装调用成功。
LLM_MODE=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 单次调用超时（秒）；超时按 LLM_TIMEOUT 记录为降级原因
LLM_TIMEOUT_SECONDS=60

# --- 本地中文 Embedding（RAG）---
# 首次运行会联网下载模型；无法下载时 RAG 检索退化为关键词路径并记录告警。
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_ENABLED=true

# --- 观测（Langfuse Cloud，可选）---
# 未配置时观测安全 no-op；配置后记录对话/LLM/工具/RAG/领域计算与错误并脱敏。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- LLM 成本单价（可选；单位 USD / 1K tokens，按 Token 估算成本）---
# 这是**假设单价**，不是供应商真实账单：未配置时成本字段为 null（不写 0）；
# 配置后评测报告标注 cost_price_assumed=true，生产环境必须用真实账单校准。
# LLM_PRICE_PER_1K_INPUT=
# LLM_PRICE_PER_1K_OUTPUT=

# --- Agent 防失控门禁 ---
# 单个 turn 的最大节点步数；超过后进入 escalate（转人工），不再调用任何工具
AGENT_MAX_STEPS=10
# 同一会话中「同一工具 + 同一规范化参数」允许的重复调用次数；超过即 loop_blocked 转人工
AGENT_TOOL_DUPLICATE_LIMIT=2

# --- MCP 只读 Server（V1.1，ADR-003 / ADR-007）---
# MCP 客户端统一以该 actor 只读执行（请求参数不能覆盖 actor，system 冒充被拒绝）。
# 必须是业务库中**真实存在的用户 id**（本仓库种子为 alice / bob），不要填角色名（如 operator）。
# 默认值为最小权限的 bob（仅 operator 角色）；指向不存在的用户时，MCP 调用会被角色校验
# 拒绝、写入审计，并返回可操作的修正提示（不会静默放行）。
MCP_ACTOR_ID=bob
